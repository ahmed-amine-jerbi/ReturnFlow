<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ReturnFlow" targetNamespace="https://github.com/ahmed-amine-jerbi/returnflow">
  <bpmn:collaboration id="Collaboration_ReturnFlow">
    <bpmn:participant id="Pool_ReturnFlow" name="ReturnFlow: returns and claims" processRef="Process_Returns" />
    <bpmn:textAnnotation id="Note_Policy"><bpmn:text>Decision policy (DecisionPolicy.cs, thresholds in appsettings.json), checked in order: 1) bought more than 30 days ago: reject. 2) no AI analysis: agent. 3) not covered (customer damage): reject if the AI is at least 0.61 sure, else agent. 4) category not in the covered list (other): agent. 5) AI under 0.59 sure, amount over 600 or risk over 0.35: agent. 6) 5% random spot-check: agent. 7) otherwise: approve.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Policy" sourceRef="Task_Policy" targetRef="Note_Policy" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Returns" name="Return and claim handling" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Start_Return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_File</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Closed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="ReturnFlow API">
        <bpmn:flowNodeRef>Task_Queue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Policy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AI" name="AI service">
        <bpmn:flowNodeRef>Task_Analyse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_AiDown</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Agent">
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Decided</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Return" name="Customer wants to return an item">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_File" name="File a claim">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Queue" name="Save and queue the claim">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Analyse" name="Analyse the claim">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Task_Policy" name="Apply decision policy">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gw_Route" name="" default="F9">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Approve" name="Approve automatically">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Reject" name="Reject automatically">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Review" name="Customer asks for a human review?">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Closed" name="Claim closed">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Review" name="Review and decide">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Decided" name="Claim decided by an agent">
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_AiDown" name="AI service down" attachedToRef="Task_Analyse">
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrDef_AiDown" errorRef="Error_AiDown" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Return" targetRef="Task_File" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_File" targetRef="Task_Queue" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Queue" targetRef="Task_Analyse" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Analyse" targetRef="Task_Policy" />
    <bpmn:sequenceFlow id="F5" name="No analysis" sourceRef="Boundary_AiDown" targetRef="Task_Policy" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Policy" targetRef="Gw_Route" />
    <bpmn:sequenceFlow id="F7" name="Eligible for auto-approval" sourceRef="Gw_Route" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="F8" name="Outside window, or not covered" sourceRef="Gw_Route" targetRef="Task_Reject" />
    <bpmn:sequenceFlow id="F9" name="Needs a person" sourceRef="Gw_Route" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Approve" targetRef="Gw_Review" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Reject" targetRef="Gw_Review" />
    <bpmn:sequenceFlow id="F12" name="No" sourceRef="Gw_Review" targetRef="End_Closed" />
    <bpmn:sequenceFlow id="F13" name="Yes" sourceRef="Gw_Review" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_Review" targetRef="End_Decided" />
  </bpmn:process>
  <bpmn:error id="Error_AiDown" name="AI service unavailable" errorCode="AI_UNAVAILABLE" />
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_ReturnFlow">
      <bpmndi:BPMNShape id="Pool_ReturnFlow_di" bpmnElement="Pool_ReturnFlow" isHorizontal="true"><dc:Bounds x="100" y="210" width="1470" height="720" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Customer_di" bpmnElement="Lane_Customer" isHorizontal="true"><dc:Bounds x="130" y="210" width="1440" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true"><dc:Bounds x="130" y="360" width="1440" height="250" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AI_di" bpmnElement="Lane_AI" isHorizontal="true"><dc:Bounds x="130" y="610" width="1440" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Agent_di" bpmnElement="Lane_Agent" isHorizontal="true"><dc:Bounds x="130" y="770" width="1440" height="160" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Return_di" bpmnElement="Start_Return"><dc:Bounds x="257" y="267" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_File_di" bpmnElement="Task_File"><dc:Bounds x="365" y="245" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Queue_di" bpmnElement="Task_Queue"><dc:Bounds x="515" y="445" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Analyse_di" bpmnElement="Task_Analyse"><dc:Bounds x="665" y="650" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Policy_di" bpmnElement="Task_Policy"><dc:Bounds x="815" y="445" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Route_di" bpmnElement="Gw_Route" isMarkerVisible="true"><dc:Bounds x="1000" y="460" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Approve_di" bpmnElement="Task_Approve"><dc:Bounds x="1115" y="380" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reject_di" bpmnElement="Task_Reject"><dc:Bounds x="1115" y="510" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Review_di" bpmnElement="Gw_Review" isMarkerVisible="true"><dc:Bounds x="1300" y="260" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1265" y="214" width="120" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Closed_di" bpmnElement="End_Closed"><dc:Bounds x="1457" y="267" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review"><dc:Bounds x="1115" y="810" width="120" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Decided_di" bpmnElement="End_Decided"><dc:Bounds x="1457" y="832" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_AiDown_di" bpmnElement="Boundary_AiDown"><dc:Bounds x="741" y="712" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="641" y="750" width="96" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_Policy_di" bpmnElement="Note_Policy"><dc:Bounds x="815" y="90" width="430" height="86" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="293" y="285" />
        <di:waypoint x="365" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="485" y="285" />
        <di:waypoint x="500" y="285" />
        <di:waypoint x="500" y="485" />
        <di:waypoint x="515" y="485" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3">
        <di:waypoint x="635" y="485" />
        <di:waypoint x="650" y="485" />
        <di:waypoint x="650" y="690" />
        <di:waypoint x="665" y="690" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="785" y="690" />
        <di:waypoint x="800" y="690" />
        <di:waypoint x="800" y="485" />
        <di:waypoint x="815" y="485" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="759" y="748" />
        <di:waypoint x="759" y="760" />
        <di:waypoint x="875" y="760" />
        <di:waypoint x="875" y="525" />
        <bpmndi:BPMNLabel><dc:Bounds x="769" y="742" width="70" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6">
        <di:waypoint x="935" y="485" />
        <di:waypoint x="1000" y="485" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7">
        <di:waypoint x="1025" y="460" />
        <di:waypoint x="1025" y="420" />
        <di:waypoint x="1115" y="420" />
        <bpmndi:BPMNLabel><dc:Bounds x="933" y="406" width="84" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8">
        <di:waypoint x="1025" y="510" />
        <di:waypoint x="1025" y="550" />
        <di:waypoint x="1115" y="550" />
        <bpmndi:BPMNLabel><dc:Bounds x="933" y="536" width="84" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9">
        <di:waypoint x="1050" y="485" />
        <di:waypoint x="1082" y="485" />
        <di:waypoint x="1082" y="850" />
        <di:waypoint x="1115" y="850" />
        <bpmndi:BPMNLabel><dc:Bounds x="1092" y="676" width="90" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10">
        <di:waypoint x="1235" y="420" />
        <di:waypoint x="1268" y="420" />
        <di:waypoint x="1268" y="285" />
        <di:waypoint x="1300" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11">
        <di:waypoint x="1235" y="550" />
        <di:waypoint x="1268" y="550" />
        <di:waypoint x="1268" y="285" />
        <di:waypoint x="1300" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12">
        <di:waypoint x="1350" y="285" />
        <di:waypoint x="1457" y="285" />
        <bpmndi:BPMNLabel><dc:Bounds x="1360" y="265" width="20" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13">
        <di:waypoint x="1325" y="310" />
        <di:waypoint x="1325" y="788" />
        <di:waypoint x="1205" y="788" />
        <di:waypoint x="1205" y="810" />
        <bpmndi:BPMNLabel><dc:Bounds x="1331" y="374" width="24" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F14_di" bpmnElement="F14">
        <di:waypoint x="1235" y="850" />
        <di:waypoint x="1457" y="850" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_Policy_di" bpmnElement="Assoc_Policy">
        <di:waypoint x="875" y="445" />
        <di:waypoint x="875" y="176" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>

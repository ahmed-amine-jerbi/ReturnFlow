# Copy to .env (never commit it). Docker Compose reads it automatically.

# Secret used to sign login tokens. Use 32+ random characters.
JWT_KEY=change-me-to-a-long-random-secret-at-least-32-chars

# true  = fake data + one-tap demo logins (use on your own network or for a short public demo)
# false = no fake data and no demo buttons; users are only created if DEMO_PASSWORD is set
DEMO_MODE=true

# Password for the seeded accounts. Choose your own, especially if the app is reachable from the internet.
DEMO_PASSWORD=ChangeMe123!

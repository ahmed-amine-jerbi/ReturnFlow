{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=returnflow;Username=returnflow;Password=returnflow_dev"
  },
  "Jwt": {
    "Issuer": "returnflow-api",
    "Audience": "returnflow-clients",
    "Key": "DEV_ONLY_change_me_to_a_long_random_secret_32+_chars"
  },
  "Seed": {
    "DemoData": true
  },
  "Policy": {
    "AutomationEnabled": true,
    "ReturnWindowDays": 30,
    "AutoApproveMaxAmount": 600,
    "MaxRiskForAutoApprove": 0.35,
    "MinConfidenceForAutoApprove": 0.59,
    "MinConfidenceForAutoReject": 0.61,
    "SpotCheckRate": 0.05,
    "CoveredCategories": [
      "damaged",
      "defective",
      "wrong_item",
      "missing_parts",
      "not_as_described",
      "late_delivery",
      "not_delivered",
      "change_of_mind"
    ],
    "NotCoveredCategories": [ "customer_damage" ]
  },
  "Ai": {
    "BaseUrl": "http://localhost:8000/"
  }
}